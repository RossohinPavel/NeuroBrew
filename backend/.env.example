# Application mode: development, production, test
NODE_ENV=development

# Database config
DATABASE_URL=postgresql://postgres:postgres@localhost:5423/neurobrew

# Redis config
REDIS_URL=redis://default:neurobrew_redis@localhost:6379

# JWT config
JWT_ACCESS_SECRET=replace_with_at_least_32_character_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_character_secret

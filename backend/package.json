{
  "name": "backend",
  "description": "Backend application for NeuroBrew",
  "author": "df17",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean:dist": "rimraf dist",
    "clean:temp": "rimraf .temp .tmp",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start": "node ./dist/main.js",
    "openapi": "tsx scripts/generateOpenapi.ts",
    "route-tree": "tsx scripts/printRoutes.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm typecheck && oxlint src --fix"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.7",
    "@fastify/redis": "^9.0.1",
    "@fastify/sensible": "^6.0.7",
    "@shared/contracts": "workspace:*",
    "@valibot/to-json-schema": "^1.8.0",
    "argon2": "^0.45.2",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "postgres": "^3.4.9",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@fastify/one-line-logger": "^2.2.1",
    "@fastify/swagger": "^9.9.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "1.0.0-rc.4",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

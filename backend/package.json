{
  "name": "backend",
  "description": "Backend application for NeuroBrew",
  "author": "df17",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/main.js",
    "openapi": "pnpm build && node --env-file=.env ./dist/scripts/generateOpenapi.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prelint": "pnpm typecheck",
    "lint": "oxlint src --fix"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.4",
    "@valibot/to-json-schema": "^1.8.0",
    "fastify": "^5.12.5",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@fastify/one-line-logger": "^2.2.1",
    "@fastify/swagger": "^9.9.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

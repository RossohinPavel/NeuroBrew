{
  "name": "backend",
  "description": "Backend application for NeuroBrew",
  "author": "df17",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prelint": "pnpm typecheck",
    "lint": "oxlint src --fix"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
